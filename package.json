{
  "name": "annie3d-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @annie3d/site build && node scripts/copy-site.mjs && pnpm --filter @annie3d/web build && node scripts/strip-maps.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "share": "node scripts/share.mjs",
    "share:stop": "node scripts/share.mjs --stop",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "perf": "node tests/perf/run-all.mjs",
    "db:generate": "pnpm --filter @annie3d/db generate",
    "db:migrate": "pnpm --filter @annie3d/db migrate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:db": "node scripts/test-db.mjs",
    "test:api": "node scripts/test-api.mjs",
    "docs:api": "npx -y tsx scripts/gen-api-doc.ts",
    "build:prod": "CLOUDFLARE_ENV=production pnpm build",
    "perf:load": "node tests/perf/load.mjs",
    "deploy:prod": "CLOUDFLARE_ENV=production pnpm build && pnpm --filter @annie3d/web exec wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.0",
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.14.5",
    "sirv": "^3.0.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
