---
import { appLink } from '../lib/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="/" class="logo" aria-label="3Dads home"><span class="logo-mark" aria-hidden="true">3D</span><span>3Dads</span></a>
      <p style="margin-top:12px;max-width:36ch">3D product advertising and animation for ecommerce teams. This site presents a demonstration release; generation runs against a simulated backend.</p>
    </div>
    <div>
      <h2 class="eyebrow" style="margin-bottom:10px">Product</h2>
      <ul>
        <li><a href="/product">How it works</a></li>
        <li><a href="/templates">Templates</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href={appLink('/signin')}>Sign in</a></li>
      </ul>
    </div>
    <div>
      <h2 class="eyebrow" style="margin-bottom:10px">Resources</h2>
      <ul>
        <li><a href="/help">Help & quickstart</a></li>
        <li><a href="/help/concepts">Runs, versions and acceptance</a></li>
        <li><a href="/help/exports">Export formats</a></li>
        <li><a href="/help/demo-limits">What the demo can and cannot do</a></li>
      </ul>
    </div>
    <div>
      <h2 class="eyebrow" style="margin-bottom:10px">Legal</h2>
      <ul>
        <li><a href="/legal/privacy">Privacy (draft)</a></li>
        <li><a href="/legal/terms">Terms (draft)</a></li>
        <li><a href="mailto:hello@3dads.example">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="container" style="margin-top:32px;font-size:0.8125rem;color:var(--text-muted)">© 2026 3Dads. Sample outputs and prices on this site are illustrative demonstrations.</div>
</footer>
