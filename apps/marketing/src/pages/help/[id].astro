---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const articles: CollectionEntry<'help'>[] = await getCollection('help');
  return articles.map((a) => ({ params: { id: a.id }, props: { article: a } }));
}
const { article } = Astro.props as { article: CollectionEntry<'help'> };
const all: CollectionEntry<'help'>[] = (await getCollection('help')).sort((a: CollectionEntry<'help'>, b: CollectionEntry<'help'>) => a.data.order - b.data.order);
const { Content, headings } = await render(article);
const idx = all.findIndex((a) => a.id === article.id);
const next = all[idx + 1];
---

<Base title={article.data.title} description={article.data.description}>
  <div class="container docs" style="padding:48px 0 96px">
    <nav class="docs-nav" aria-label="Help articles">
      {all.map((a) => <a href={`/help/${a.id}`} aria-current={a.id === article.id ? 'page' : undefined}>{a.data.title}</a>)}
    </nav>
    <article class="prose">
      <p class="eyebrow">Help</p>
      <h1 class="h2" style="margin-top:8px">{article.data.title}</h1>
      <p class="lead" style="margin-top:8px">{article.data.description}</p>
      {headings.length > 2 ? <nav aria-label="On this page" class="notice" style="margin-top:20px"><strong>On this page</strong><ul style="margin:6px 0 0;padding-left:18px">{headings.filter((h: { depth: number }) => h.depth === 2).map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav> : null}
      <Content />
      {next ? <p style="margin-top:32px"><strong>Next:</strong> <a href={`/help/${next.id}`}>{next.data.title}</a></p> : null}
    </article>
  </div>
</Base>
