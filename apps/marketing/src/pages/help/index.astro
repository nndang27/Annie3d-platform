---
import { type CollectionEntry, getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const articles: CollectionEntry<'help'>[] = (await getCollection('help')).sort((a: CollectionEntry<'help'>, b: CollectionEntry<'help'>) => a.data.order - b.data.order);
---

<Base title="Help and quickstart" description="Quickstart, concepts, export formats, demo limits and troubleshooting for 3Dads.">
  <section class="container section-tight" style="padding-top:56px">
    <p class="eyebrow">Help</p>
    <h1 class="h1" style="margin-top:12px;max-width:18ch">Get to a first result, then understand what you see.</h1>
    <div class="grid-2" style="margin-top:32px">
      {articles.map((a) => <a href={`/help/${a.id}`} class="card card-pad" style="color:inherit;display:grid;gap:6px"><h2 class="h3">{a.data.title}</h2><p style="color:var(--text-secondary);font-size:0.95rem">{a.data.description}</p></a>)}
    </div>
  </section>
  <section class="container section-tight" style="padding-bottom:96px" aria-labelledby="h-faq">
    <h2 id="h-faq" class="h2">Frequently asked</h2>
    <div class="faq" style="margin-top:16px;max-width:760px">
      <details><summary>Where is my data stored?</summary><p>In your browser (IndexedDB and local storage), scoped to the workspace you are signed into. Nothing is uploaded in the demonstration.</p></details>
      <details><summary>Can two people edit the same project?</summary><p>Members and roles are simulated. The demo does not synchronise edits between browsers.</p></details>
      <details><summary>Why does the model not look like my product?</summary><p>The demo does not reconstruct images. It uses a labelled catalog fixture to show the workflow, scene controls and exports.</p></details>
      <details><summary>How do I report a problem?</summary><p>Email hello@3dads.example with the project id and, if possible, the run id from the run panel.</p></details>
    </div>
  </section>
</Base>
