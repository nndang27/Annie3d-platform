---
import { PLANS, USAGE_UNIT, yearlyMonthlyEquivalent } from '@annie3d/contracts';
import Base from '../layouts/Base.astro';
import { appLink } from '../lib/site';
const rows: [string, (p: (typeof PLANS)[number]) => string][] = [
  ['Render credits / month', (p) => String(p.creditsPerMonth)],
  ['Seats', (p) => String(p.seats)],
  ['Active projects', (p) => (p.maxProjects === 'unlimited' ? 'Unlimited' : String(p.maxProjects))],
  ['Export presets', (p) => p.exportPresets.join(', ')],
  ['What stops work', (p) => p.limitsThatStopWork.join(' ')],
  ['What adds charges', (p) => p.limitsThatCharge.join(' ') || 'Nothing'],
];
---

<Base title="Pricing" description="Illustrative Annie 3D plans: Starter, Studio and Team, billed monthly or yearly, with render credits as the usage unit.">
  <section class="container section-tight" style="padding-top:56px">
    <p class="eyebrow">Pricing</p>
    <h1 class="h1" style="margin-top:12px;max-width:18ch">Simple plans, one usage unit.</h1>
    <p class="lead" style="margin-top:16px">Prices are in USD and are illustrative for this demonstration; no purchase is processed. Checkout is simulated end to end so you can see the whole journey.</p>
    <div class="segmented" role="radiogroup" aria-label="Billing interval" style="margin-top:24px" data-interval>
      <button type="button" role="radio" aria-checked="true" data-value="monthly">Monthly</button>
      <button type="button" role="radio" aria-checked="false" data-value="yearly">Yearly <span class="badge badge-success" style="margin-left:4px">2 months free</span></button>
    </div>
  </section>
  <section class="container" style="padding-bottom:40px">
    <div class="pricing-grid" data-plans>
      {PLANS.map((p) => (
        <div class={`card plan ${p.id === 'studio' ? 'is-featured' : ''}`} data-plan={p.id} data-testid={`pricing-${p.id}`}>
          <div><h2 class="h3">{p.name}</h2><p style="color:var(--text-secondary);font-size:0.95rem;margin-top:4px">{p.tagline}</p></div>
          <div>
            <div class="price"><span data-price-monthly={p.monthlyUsd} data-price-yearly={yearlyMonthlyEquivalent(p)}>${p.monthlyUsd}</span><small> / month</small></div>
            <div style="font-size:0.8125rem;color:var(--text-muted)" data-yearly-note hidden>${p.yearlyUsd} billed yearly</div>
          </div>
          <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
          <a class={`btn ${p.id === 'studio' ? 'btn-primary' : 'btn-secondary'}`} href={appLink('/signin', { plan: p.id, interval: 'monthly', returnTo: `/app/billing/checkout?plan=${p.id}&interval=monthly` })} data-plan-link={p.id} data-testid={`choose-${p.id}`}>{p.monthlyUsd === 0 ? 'Start free' : `Choose ${p.name}`}</a>
        </div>
      ))}
    </div>
  </section>
  <section class="container section-tight" aria-labelledby="h-unit">
    <div class="card card-pad" style="display:grid;gap:10px">
      <h2 id="h-unit" class="h3">What a render credit buys</h2>
      <p class="body">{USAGE_UNIT.explanation}</p>
      <p class="body" style="font-size:0.95rem"><strong>Sample calculation — {USAGE_UNIT.sample.template}:</strong> {USAGE_UNIT.sample.steps.map(([s, c]) => `${s} ${c}`).join(' + ')} = {USAGE_UNIT.sample.steps.reduce((a, [, c]) => a + c, 0)} credits per full run.</p>
    </div>
  </section>
  <section class="container section-tight" aria-labelledby="h-compare">
    <h2 id="h-compare" class="h2">Compare plans</h2>
    <div class="table-wrap" style="margin-top:20px">
      <table class="compare-table">
        <thead><tr><th scope="col">Feature</th>{PLANS.map((p) => <th scope="col">{p.name}</th>)}</tr></thead>
        <tbody>{rows.map(([label, fn]) => <tr><th scope="row">{label}</th>{PLANS.map((p) => <td>{fn(p)}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p style="font-size:0.875rem;color:var(--text-secondary);margin-top:12px">Upgrade and downgrade take effect immediately in the demo; cancellation keeps access until the period ends. Yearly plans show the monthly equivalent and the annual charge.</p>
  </section>
  <section class="container section-tight" style="padding-bottom:96px" aria-labelledby="h-faq">
    <h2 id="h-faq" class="h2">Pricing questions</h2>
    <div class="faq" style="margin-top:16px;max-width:760px">
      <details><summary>Are these real prices?</summary><p>No. They are illustrative values so the pricing, checkout and entitlement journey can be demonstrated and tested. No card is requested and nothing is charged.</p></details>
      <details><summary>What happens when I run out of credits?</summary><p>New runs and queued renders stop with a clear message; existing outputs stay accessible. Studio and Team can enable optional overage in the live product.</p></details>
      <details><summary>Can I change plans mid-cycle?</summary><p>Yes. In the demo the change applies right away; the live product would prorate according to the provider's rules.</p></details>
      <details><summary>Do manual edits cost credits?</summary><p>No. Only engine work — model builds, clips, variants and queued renders — uses credits. Editing, undo and browser exports are free.</p></details>
    </div>
  </section>
  <script>
    const group = document.querySelector<HTMLElement>('[data-interval]');
    if (group) {
      const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-value]'));
      const apply = (interval: 'monthly' | 'yearly') => {
        for (const b of buttons) b.setAttribute('aria-checked', String(b.dataset.value === interval));
        for (const plan of document.querySelectorAll<HTMLElement>('[data-plan]')) {
          const price = plan.querySelector<HTMLElement>('[data-price-monthly]')!;
          price.textContent = `$${interval === 'monthly' ? price.dataset.priceMonthly : price.dataset.priceYearly}`;
          const note = plan.querySelector<HTMLElement>('[data-yearly-note]')!;
          note.hidden = interval !== 'yearly' || price.dataset.priceMonthly === '0';
          const link = plan.querySelector<HTMLAnchorElement>('[data-plan-link]')!;
          const id = link.dataset.planLink!;
          const url = new URL(link.href, location.origin);
          url.searchParams.set('interval', interval);
          url.searchParams.set('returnTo', `/app/billing/checkout?plan=${id}&interval=${interval}`);
          link.href = url.pathname + url.search;
        }
        const url = new URL(location.href);
        url.searchParams.set('interval', interval);
        history.replaceState(null, '', url);
      };
      buttons.forEach((b, i) => {
        b.addEventListener('click', () => {
          apply(b.dataset.value as 'monthly' | 'yearly');
          b.focus(); // Safari does not focus buttons on click; keyboard arrows must still work afterwards
        });
        b.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const next = buttons[(i + (e.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length]!;
            apply(next.dataset.value as 'monthly' | 'yearly');
            next.focus();
          }
        });
      });
      const initial = new URL(location.href).searchParams.get('interval');
      apply(initial === 'yearly' ? 'yearly' : 'monthly');
    }
  </script>
</Base>
