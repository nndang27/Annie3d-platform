---
import type { Template } from '@annie3d/contracts';
import { Image } from 'astro:assets';
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/posters/*.webp', { eager: true });
interface Props {
  template: Template;
  eager?: boolean;
}
const { template, eager = false } = Astro.props;
const poster = posters[`../assets/posters/${template.slug}.webp`]?.default;
---

<a href={`/templates/${template.slug}`} class="card template-card" data-template data-name={template.name.toLowerCase()} data-category={template.category} data-tags={template.tags.join(' ')} data-text={`${template.name} ${template.outcome} ${template.suitableFor} ${template.tags.join(' ')}`.toLowerCase()}>
  {poster ? <Image src={poster} alt={`Sample output of the ${template.name} template (demonstration render)`} width={480} height={360} loading={eager ? 'eager' : 'lazy'} decoding="async" widths={[320, 480, 640]} sizes="(min-width: 900px) 30vw, 90vw" /> : null}
  <div>
    <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline">
      <strong>{template.name}</strong>
      <span class="badge">{template.category}</span>
    </div>
    <p style="font-size:0.9rem;color:var(--text-secondary);margin-top:4px">{template.outcome}</p>
    <p style="font-size:0.8125rem;color:var(--text-muted);margin-top:6px">{template.aspects.join(' · ')} · ~{template.sampleCredits} demo credits</p>
  </div>
</a>
