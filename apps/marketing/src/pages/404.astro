---
import Base from '../layouts/Base.astro';
import { appLink } from '../lib/site';
---

<Base title="Page not found" description="The page you followed does not exist." noindex>
  <div class="container" style="padding:96px 0;max-width:640px">
    <p class="badge">404</p>
    <h1 class="h2" style="margin-top:12px">That page does not exist.</h1>
    <p class="lead" style="margin-top:12px">The link may be outdated. Here is where most people want to go:</p>
    <ul style="margin:20px 0 0;padding-left:18px;display:grid;gap:8px;color:var(--text-secondary)">
      <li><a href="/templates">Browse templates</a></li>
      <li><a href="/help">Read the quickstart</a></li>
      <li><a href="/pricing">Compare plans</a></li>
      <li><a href={appLink('/signin')}>Sign in to the demo workspace</a></li>
    </ul>
  </div>
</Base>
