{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "annie3d",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-24",
  // pg and Better Auth need Node APIs (Cloudflare Hyperdrive + node-postgres guide).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // Canvas is a SPA; unknown paths serve index.html (Workers static assets SPA routing).
    "not_found_handling": "single-page-application",
    // API and share pages always hit the Worker, in dev and prod alike.
    "run_worker_first": ["/api/*", "/s/*", "/billing/*"]
  },
  "observability": { "enabled": true },
  // Daily: delete expired desktop working copies (services/cleanup.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  // Remote bindings in dev: the Worker runs locally but reads/writes the real buckets, so
  // presigned browser uploads and server-side HEAD checks see the same objects.
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "annie3d-uploads", "remote": true },
    { "binding": "ARTIFACTS", "bucket_name": "annie3d-artifacts", "remote": true },
    { "binding": "PUBLIC", "bucket_name": "annie3d-public", "remote": true }
  ],
  // Local dev connects straight to Neon via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // (set by scripts/dev.mjs); the real id is filled in at deploy (P10).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  // Workers Rate Limiting binding; period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_RUN", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // One Durable Object per run (alarms + hibernatable WebSockets); SimRoom relays F13 remote links.
  "durable_objects": {
    "bindings": [
      { "name": "RUN_ROOM", "class_name": "RunRoom" },
      { "name": "SIM_ROOM", "class_name": "SimRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["SimRoom"] }
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:5173",
    "R2_KEY_PREFIX": "dev/",
    "SIM_SPEED": "1"
  },
  // Production: CLOUDFLARE_ENV=production at build time (Cloudflare Vite plugin environments).
  // Bindings are not inherited by environments, so each one is declared again here.
  // Secrets (wrangler secret bulk --env production): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, CLOUDFLARE_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.
  // ANNIE3D_TEST_AUTH is never set in production.
  "env": {
    "production": {
      "name": "annie3d",
      "workers_dev": true,
      "triggers": { "crons": ["17 3 * * *"] },
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "annie3d-uploads" },
        { "binding": "ARTIFACTS", "bucket_name": "annie3d-artifacts" },
        { "binding": "PUBLIC", "bucket_name": "annie3d-public" }
      ],
      // Neon `production` branch (Sydney) through Hyperdrive "annie3d-prod".
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "b0c9492373ec4b19a349375a4f2bdffb" }],
      "ratelimits": [
        { "name": "RL_WRITE", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_RUN", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_UPLOAD", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RUN_ROOM", "class_name": "RunRoom" },
          { "name": "SIM_ROOM", "class_name": "SimRoom" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RunRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["SimRoom"] }
      ],
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://annie3d.nndang2701.workers.dev",
        "R2_KEY_PREFIX": "",
        "SIM_SPEED": "1"
      }
    }
  }
}
