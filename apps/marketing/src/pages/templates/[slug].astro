---
import { TEMPLATES, PRODUCT_FIXTURES } from '@3dads/contracts';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import { appLink } from '../../lib/site';

export function getStaticPaths() {
  return TEMPLATES.map((t) => ({ params: { slug: t.slug }, props: { template: t } }));
}
const { template } = Astro.props;
const posters = import.meta.glob<{ default: ImageMetadata }>('../../assets/posters/*.webp', { eager: true });
const poster = posters[`../../assets/posters/${template.slug}.webp`]?.default;
const related = TEMPLATES.filter((t) => t.slug !== template.slug && t.category === template.category).slice(0, 3);
const fixture = PRODUCT_FIXTURES[template.fixtureId];
---

<Base title={`${template.name} template`} description={template.outcome}>
  <section class="container section-tight" style="padding-top:56px">
    <nav aria-label="Breadcrumb" style="font-size:0.875rem;color:var(--text-muted)"><a href="/templates">Templates</a> / {template.category}</nav>
    <div class="feature" style="margin-top:16px;align-items:start">
      <div>
        <h1 class="h1" style="font-size:clamp(2rem,3.5vw,3rem)">{template.name}</h1>
        <p class="lead" style="margin-top:12px">{template.outcome}</p>
        <p class="body" style="margin-top:8px"><strong>Suitable for:</strong> {template.suitableFor}</p>
        <div class="tags" style="margin-top:12px">{template.tags.map((t) => <span class="badge">{t}</span>)}</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px">
          <a class="btn btn-primary btn-lg btn-pill" href={appLink('/signup', { template: template.slug })} data-testid="use-template">Use this template</a>
          <a class="btn btn-secondary btn-lg btn-pill" href={appLink('/signin', { template: template.slug })}>Sign in and use it</a>
        </div>
        <p style="font-size:0.8125rem;color:var(--text-muted);margin-top:10px">Your template choice is kept through sign-up and sign-in.</p>
      </div>
      <div class="preview-frame">
        {poster ? <Image src={poster} alt={`Sample output of the ${template.name} template (demonstration render of the ${fixture.name} fixture)`} width={960} height={720} widths={[480, 960]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" /> : null}
        <p style="padding:10px 14px;font-size:0.8125rem;color:var(--text-muted);border-top:1px solid var(--border-subtle)">Sample output · demonstration fixture: {fixture.name} · {template.scene.background} · {template.scene.light} · {template.scene.animation}</p>
      </div>
    </div>
  </section>
  <section class="container section-tight">
    <div class="grid-3">
      <div class="card card-pad"><h2 class="h3">Required input</h2><ul style="margin:8px 0 0;padding-left:18px;color:var(--text-secondary);font-size:0.95rem">{template.requiredInput.map((i) => <li>{i}</li>)}</ul></div>
      <div class="card card-pad"><h2 class="h3">Deliverable</h2><ul style="margin:8px 0 0;padding-left:18px;color:var(--text-secondary);font-size:0.95rem">{template.deliverable.map((i) => <li>{i}</li>)}</ul></div>
      <div class="card card-pad"><h2 class="h3">Limits</h2><ul style="margin:8px 0 0;padding-left:18px;color:var(--text-secondary);font-size:0.95rem">{template.limits.map((i) => <li>{i}</li>)}</ul></div>
    </div>
    <div class="card card-pad" style="margin-top:20px">
      <h2 class="h3">Steps in this workflow</h2>
      <ol style="margin:10px 0 0;padding-left:20px;color:var(--text-secondary);font-size:0.95rem;display:grid;gap:4px">{template.nodes.map((n) => <li>{n.kind.replace('-', ' ')}</li>)}</ol>
      <p style="font-size:0.8125rem;color:var(--text-muted);margin-top:10px">Estimated usage: about {template.sampleCredits} demo credits per full run{template.sampleDurationSec ? ` · ${template.sampleDurationSec} s clip` : ''}. Formats: {template.aspects.join(', ')}.</p>
    </div>
  </section>
  {related.length ? <section class="container section-tight" style="padding-bottom:96px"><h2 class="h2">Related templates</h2><div class="grid-3" style="margin-top:20px">{related.map((t) => <TemplateCard template={t} />)}</div></section> : null}
</Base>
