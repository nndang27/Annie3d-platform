---
import { CANVAS, CONTACT_EMAIL, LINKEDIN, type LocaleProps, localePath, pageT } from '../lib/site';

const { locale } = Astro.props as LocaleProps;
const t = pageT(locale);
const keep = locale === 'en' ? undefined : locale;
const home = localePath(locale, '/home');
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={home} class="logo" aria-label={t('site.nav.homeLabel')}><img class="logo-img" src="/favicon.svg" alt="" width="28" height="28" /><span>{t('common.brand')}</span></a>
      <p>{t('site.home.headline')}</p>
    </div>
    <nav aria-label={t('site.footer.product')}>
      <h2>{t('site.footer.product')}</h2>
      <ul>
        <li><a href={CANVAS} data-lang={keep}>{t('site.nav.canvas')}</a></li>
        <li><a href={`${home}#features`}>{t('site.nav.features')}</a></li>
        <li><a href={`${home}#pricing`}>{t('site.nav.pricing')}</a></li>
        <li><a href={`${home}#faq`}>{t('site.nav.faq')}</a></li>
      </ul>
    </nav>
    <nav aria-label={t('site.footer.company')}>
      <h2>{t('site.footer.company')}</h2>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{t('site.nav.contact')}</a></li>
        <li><a href={LINKEDIN} rel="noopener">LinkedIn</a></li>
      </ul>
    </nav>
    <nav aria-label={t('site.footer.legal')}>
      <h2>{t('site.footer.legal')}</h2>
      <ul>
        <li><a href={localePath(locale, '/legal/privacy')}>{t('site.nav.privacy')}</a></li>
        <li><a href={localePath(locale, '/legal/terms')}>{t('site.nav.terms')}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-legal">{t('site.footer.copyright')}</div>
</footer>
