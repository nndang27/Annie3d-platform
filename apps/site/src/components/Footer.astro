---
import { CANVAS, CONTACT_EMAIL, type LocaleProps, localePath, pageT } from '../lib/site';

const { locale } = Astro.props as LocaleProps;
const t = pageT(locale);
const keep = locale === 'en' ? undefined : locale;
---

<footer class="site-footer">
  <div class="container" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center">
    <a href={localePath(locale, '/home')} class="logo" aria-label={t('site.nav.homeLabel')}><span class="logo-mark" aria-hidden="true">A</span><span>{t('common.brand')}</span></a>
    <nav aria-label={t('site.nav.footer')} style="display:flex;gap:20px;font-size:0.875rem">
      <a href={CANVAS} data-lang={keep}>{t('site.nav.canvas')}</a>
      <a href={localePath(locale, '/legal/privacy')}>{t('site.nav.privacy')}</a>
      <a href={localePath(locale, '/legal/terms')}>{t('site.nav.terms')}</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{t('site.nav.contact')}</a>
    </nav>
  </div>
  <div class="container" style="margin-top:24px;font-size:0.8125rem;color:var(--text-muted)">{t('site.footer.copyright')}</div>
</footer>
