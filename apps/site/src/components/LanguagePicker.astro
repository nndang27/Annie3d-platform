---
import { LOCALES } from '@annie3d/i18n';
import { type LocaleProps, localePath, pageT } from '../lib/site';

interface Props extends LocaleProps {
  path: string;
}
const { locale, path } = Astro.props;
const t = pageT(locale);
const current = LOCALES.find((l) => l.code === locale)!;
---

<details class="lang-picker" data-testid="site-language">
  <summary aria-label={t('lang.button', { language: current.name })}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
    <span>{current.name}</span>
  </summary>
  <nav aria-label={t('site.nav.languages')}>
    <ul>
      {
        LOCALES.map((l) => (
          <li>
            <a
              href={localePath(l.code, path)}
              hreflang={l.tag}
              lang={l.tag}
              data-lang={l.code}
              aria-current={l.code === locale ? 'page' : undefined}
            >
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>
