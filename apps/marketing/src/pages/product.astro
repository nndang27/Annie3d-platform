---
import { NODE_KINDS } from '@annie3d/contracts';
import Base from '../layouts/Base.astro';
import { appLink } from '../lib/site';
const kinds = Object.values(NODE_KINDS).filter((k) => k.kind !== 'comment');
const states = [
  ['Draft', 'Inputs and settings are editable. Nothing has run.'],
  ['Queued', 'Accepted by the backend; waiting for a worker. Can be cancelled.'],
  ['Running', 'Current step, measured progress and usable partial outputs. Can be stopped or paused.'],
  ['Waiting for input', 'The exact question and options are shown; answering resumes the run.'],
  ['Paused', 'A checkpoint is kept. Resume or cancel.'],
  ['Completed', 'Every step finished. Outputs are versioned and ready for review; acceptance is a separate decision.'],
  ['Failed', 'The specific step and reason. Retry runs only the failed step and reuses earlier outputs.'],
  ['Cancelled', 'What stopped and what was already produced. Late output from a cancelled run is discarded.'],
];
---

<Base title="Product — how the workflow works" description="What a Annie 3D workflow contains: steps, inputs, execution states, editing, versions and exports.">
  <section class="container section-tight" style="padding-top:56px">
    <p class="eyebrow">Product</p>
    <h1 class="h1" style="margin-top:12px;max-width:20ch">A workflow you can read, run and revise.</h1>
    <p class="lead" style="margin-top:16px">A Annie 3D project is a small graph of steps. Each step declares its inputs and outputs, runs with visible status, and produces a versioned output you can inspect in 3D, edit and export.</p>
  </section>

  <section class="container section-tight" aria-labelledby="h-steps">
    <h2 id="h-steps" class="h2">The steps</h2>
    <div class="grid-3" style="margin-top:20px">
      {kinds.map((k) => (
        <div class="card card-pad">
          <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline"><h3 class="h3">{k.title}</h3><span class="badge">{k.executable ? `${k.credits} credit${k.credits === 1 ? '' : 's'}` : 'input'}</span></div>
          <p class="body" style="font-size:0.95rem;margin-top:6px">{k.description}</p>
          <p style="font-size:0.8125rem;color:var(--text-muted);margin-top:8px">In: {k.inputs.map((p) => p.label + (p.required ? '*' : '')).join(', ') || '—'} · Out: {k.output?.label ?? '—'} · {k.engine}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container section-tight" aria-labelledby="h-states">
    <h2 id="h-states" class="h2">Execution states</h2>
    <p class="body" style="margin-top:8px">The interface answers four questions at all times: what is happening, what finished, does anything need you, what can you do next.</p>
    <div class="table-wrap" style="margin-top:20px">
      <table class="compare-table">
        <thead><tr><th scope="col">State</th><th scope="col">What you see and can do</th></tr></thead>
        <tbody>{states.map(([s, d]) => <tr><th scope="row">{s}</th><td>{d}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="container section-tight" aria-labelledby="h-edit">
    <div class="feature">
      <div>
        <h2 id="h-edit" class="h2">Prompt-led, with real manual controls.</h2>
        <p class="body" style="margin-top:12px">The composer accepts short commands — “set background to charcoal”, “headline: Glow, bottled”, “create an orbit workflow”, “run the animation step”, “export PNG” — and applies them to the scene, the workflow or the run. It is rule-based in the demonstration and says so. Everything it can do you can also do by hand: add and connect steps on the canvas or in the list view, adjust settings in the inspector, change scene and ad properties in the studio.</p>
      </div>
      <div class="card card-pad" style="display:grid;gap:8px;font-size:0.9rem">
        <div class="badge badge-dark" style="justify-self:start">Composer</div>
        <div style="padding:10px 12px;border-radius:12px;background:var(--bg-subtle)">› Set background to charcoal and duration 8 s</div>
        <div style="padding:10px 12px;border-radius:12px;background:var(--success-soft);color:var(--success)">Applied: background → charcoal, duration → 8s. Scene revision 4 saved.</div>
        <div style="padding:10px 12px;border-radius:12px;background:var(--bg-subtle)">› Write me a jingle</div>
        <div style="padding:10px 12px;border-radius:12px;background:var(--warning-soft);color:var(--warning)">Outside what the demo composer can do. It handles scene and ad properties, workflow presets, runs and exports.</div>
      </div>
    </div>
  </section>

  <section class="container section-tight" aria-labelledby="h-versions">
    <h2 id="h-versions" class="h2">Versions, acceptance and exports</h2>
    <div class="grid-3" style="margin-top:20px">
      <div class="card card-pad"><h3 class="h3">Versions</h3><p class="body" style="font-size:0.95rem;margin-top:6px">Every run adds a revision to each output lineage. Earlier revisions stay, can be compared side by side and reopened in the studio.</p></div>
      <div class="card card-pad"><h3 class="h3">Acceptance</h3><p class="body" style="font-size:0.95rem;margin-top:6px">Execution status, preview availability and your acceptance are separate. A completed run is not an accepted ad until you say so.</p></div>
      <div class="card card-pad"><h3 class="h3">Exports</h3><p class="body" style="font-size:0.95rem;margin-top:6px">PNG stills and WebM clips rendered by your browser, editable scene JSON, and a queued MP4 render that delivers a labelled sample in the demo.</p></div>
    </div>
    <div style="margin-top:32px;display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-primary btn-lg btn-pill" href={appLink('/signup')}>Start a project</a><a class="btn btn-secondary btn-lg btn-pill" href="/templates">See templates</a></div>
  </section>
</Base>
