{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "annie3d",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-24",
  // pg and Better Auth need Node APIs (Cloudflare Hyperdrive + node-postgres guide).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // Canvas is a SPA; unknown paths serve index.html (Workers static assets SPA routing).
    "not_found_handling": "single-page-application",
    // API and share pages always hit the Worker, in dev and prod alike.
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "annie3d-uploads" },
    { "binding": "ARTIFACTS", "bucket_name": "annie3d-artifacts" },
    { "binding": "PUBLIC", "bucket_name": "annie3d-public" }
  ],
  "vars": {
    "APP_ENV": "development",
    "R2_KEY_PREFIX": "dev/"
  }
}
