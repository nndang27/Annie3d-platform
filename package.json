{
  "name": "annie3d-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @annie3d/web dev",
    "build": "pnpm --filter @annie3d/site build && node scripts/copy-site.mjs && pnpm --filter @annie3d/web build",
    "preview": "pnpm --filter @annie3d/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "node tests/perf/run-all.mjs",
    "db:generate": "pnpm --filter @annie3d/db generate",
    "db:migrate": "pnpm --filter @annie3d/db migrate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:db": "node scripts/test-db.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.0",
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.14.5",
    "sirv": "^3.0.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
