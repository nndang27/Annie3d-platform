---
import { TEMPLATES, TEMPLATE_CATEGORIES } from '@3dads/contracts';
import Base from '../../layouts/Base.astro';
import TemplateCard from '../../components/TemplateCard.astro';
---

<Base title="Templates and use cases" description="Searchable gallery of 3Dads templates: turntable hero, feature callouts, social teasers, colour variants, dimensions and comparisons.">
  <section class="container section-tight" style="padding-top:56px">
    <p class="eyebrow">Templates</p>
    <h1 class="h1" style="margin-top:12px;max-width:18ch">Pick the outcome. The workflow comes with it.</h1>
    <p class="lead" style="margin-top:16px">Each template defines the steps, scene defaults and formats. Search by product type or goal; the selection is kept through sign-up.</p>
    <form role="search" style="margin-top:24px;display:flex;gap:10px;flex-wrap:wrap;align-items:center" data-template-search onsubmit="return false">
      <label class="visually-hidden" for="tpl-q">Search templates</label>
      <input id="tpl-q" type="search" class="input" placeholder="Search templates (e.g. skincare, vertical, dimensions)" style="max-width:420px" data-testid="template-search" />
      <label class="visually-hidden" for="tpl-cat">Category</label>
      <select id="tpl-cat" class="select" style="width:200px"><option value="all">All categories</option>{TEMPLATE_CATEGORIES.map((c) => <option value={c}>{c}</option>)}</select>
      <button type="button" class="btn btn-tertiary" data-clear>Clear</button>
      <span style="font-size:0.875rem;color:var(--text-muted)" data-count aria-live="polite">{TEMPLATES.length} templates</span>
    </form>
  </section>
  <section class="container" style="padding-bottom:96px">
    <div class="grid-3" data-template-grid>{TEMPLATES.map((t, i) => <TemplateCard template={t} eager={i < 3} />)}</div>
    <p class="empty" hidden data-empty style="margin-top:16px"><span class="empty-title">No templates match.</span> Try a broader word or clear the filters.</p>
    <p style="margin-top:16px;font-size:0.8125rem;color:var(--text-muted)">Sample outputs are demonstration renders of catalog fixtures.</p>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('[data-template-search]');
    const q = document.getElementById('tpl-q') as HTMLInputElement | null;
    const cat = document.getElementById('tpl-cat') as HTMLSelectElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-template]'));
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const count = document.querySelector<HTMLElement>('[data-count]');
    const apply = () => {
      const needle = (q?.value ?? '').trim().toLowerCase();
      const c = cat?.value ?? 'all';
      let n = 0;
      for (const card of cards) {
        const ok = (c === 'all' || card.dataset.category === c) && (!needle || (card.dataset.text ?? '').includes(needle));
        card.hidden = !ok;
        if (ok) n += 1;
      }
      if (empty) empty.hidden = n > 0;
      if (count) count.textContent = `${n} template${n === 1 ? '' : 's'}`;
      const url = new URL(location.href);
      if (needle) url.searchParams.set('q', needle); else url.searchParams.delete('q');
      if (c !== 'all') url.searchParams.set('category', c); else url.searchParams.delete('category');
      history.replaceState(null, '', url);
    };
    if (form && q && cat) {
      const url = new URL(location.href);
      q.value = url.searchParams.get('q') ?? '';
      cat.value = url.searchParams.get('category') ?? 'all';
      q.addEventListener('input', apply);
      cat.addEventListener('change', apply);
      form.querySelector('[data-clear]')?.addEventListener('click', () => { q.value = ''; cat.value = 'all'; apply(); q.focus(); });
      apply();
    }
  </script>
</Base>
