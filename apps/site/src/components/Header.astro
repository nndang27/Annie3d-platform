---
import { CANVAS, type LocaleProps, localePath, pageT } from '../lib/site';
import LanguagePicker from './LanguagePicker.astro';

interface Props extends LocaleProps {
  /** This page's path without the language prefix, for the language links. */
  path: string;
}
const { locale, path } = Astro.props;
const t = pageT(locale);
// From a page in another language, opening the canvas keeps that language (see scripts/lang.ts).
const keep = locale === 'en' ? undefined : locale;
const home = localePath(locale, '/home');
// Sections of the landing page; from another page they lead back to it.
const onHome = path === '/home';
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
---

<header class="site-header">
  <div class="container">
    <a href={home} class="logo" aria-label={t('site.nav.homeLabel')}><img class="logo-img" src="/favicon.svg" alt="" width="28" height="28" /><span>{t('common.brand')}</span></a>
    <nav class="site-nav" aria-label={t('site.nav.menu')}>
      <a href={anchor('features')}>{t('site.nav.features')}</a>
      <a href={anchor('how')}>{t('site.nav.howItWorks')}</a>
      <a href={anchor('pricing')}>{t('site.nav.pricing')}</a>
      <a href={anchor('faq')}>{t('site.nav.faq')}</a>
    </nav>
    <div class="site-actions" style="display:flex;margin-left:auto">
      <LanguagePicker locale={locale} path={path} />
      <a class="nav-signin" href={CANVAS} data-lang={keep}>{t('site.nav.signIn')}</a>
      <a class="lp-btn lp-btn-primary lp-btn-sm" href={CANVAS} data-lang={keep} data-testid="header-open-canvas">{t('site.nav.openCanvas')}</a>
    </div>
  </div>
</header>
